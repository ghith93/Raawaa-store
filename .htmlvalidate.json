{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "require-sri": "off",
    "element-required-attributes": "error",
    "no-dup-id": "error",
    "no-dup-attr": "error",
    "wcag/h30": "error",
    "wcag/h32": "error",
    "wcag/h37": "error",
    "wcag/h63": "error",
    "wcag/h67": "error",
    "wcag/h71": "error",
    "long-title": ["error", { "maxlength": 120 }],
    "attribute-boolean-style": "off",
    "void-style": "off",
    "no-trailing-whitespace": "off"
  }
}
