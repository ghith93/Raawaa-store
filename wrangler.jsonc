{
  // RAWAA — نشر ثابت على Cloudflare Workers (Static Assets).
  // لا يوجد "main": لا كود Worker يُنفَّذ إطلاقًا، لذلك لا تُحتسب طلبات
  // على حصة Workers (100k/يوم). الملفات الثابتة مجانية وغير محدودة.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raawaa-store",
  "compatibility_date": "2026-10-28",

  "assets": {
    "directory": "./dist/site",
    "not_found_handling": "404-page"
  },

  "workers_dev": true,
  "preview_urls": false
}
