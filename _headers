# رؤوس الأمان — تُقرأ تلقائيًا من Cloudflare Pages و Netlify
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.facebook.com https://connect.facebook.net; font-src 'self'; connect-src 'self' https://www.facebook.com https://connect.facebook.net https://oyoyozdugicmnkfhjovo.supabase.co; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests

# الصور تحمل لاحقة إصدار — التخزين الطويل آمن على الملفات المرقّمة فقط
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# صور وفيديوهات حماة غير مرقّمة بإصدار: أسبوع واحد بدل immutable
/assets/img/hama/*
  Cache-Control: public, max-age=604800

# الخطوط ثابتة أيضًا
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# صفحات HTML: تُعاد المراجعة دائمًا. السبب: بعد كل نشر تتغيّر أسماء الأصول
# (sw.js، الصور المرقّمة)؛ نسخة HTML قديمة في الكاش تطلب ملفًا لم يبقَ.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/serum
  Cache-Control: public, max-age=0, must-revalidate
/hama
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: no-cache

# صفحات تشخيص وإعداد داخلية: لا تُفهرس ولا تُؤرشف (احتياطًا لوسم meta).
/check.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
/setup.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

# القياس اختياري ولا يعمل بلا معرّف وموافقة؛ تُسمح نطاقات Meta فقط لتهيئته مستقبلًا.
/js/*.js
  Cache-Control: public, max-age=0, must-revalidate

/js/config.js
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# ELYRA: isolated concept preview only; never index or cache it.
/elyra/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

# لوحة خاصة: بلا تخزين، فهرسة أو مصادر خارجية باستثناء Supabase للمصادقة.
/owner/*
  Cache-Control: no-store, private
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src https://oyoyozdugicmnkfhjovo.supabase.co

# نصوص الفيديو المرفقة (captions) — بعض الخوادم تخدمها كـ octet-stream فترفضها المتصفحات
/assets/img/hama/*.vtt
  Content-Type: text/vtt
  Cache-Control: public, max-age=604800
